{
  "name": "@poseidon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Poseidon mobile-first personal dive journal application.",
  "scripts": {
    "predev": "python3 ../../tools/brand/build.py && node scripts/sync-assets.mjs",
    "dev": "vite",
    "prebuild": "python3 ../../tools/brand/build.py && node scripts/sync-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/sync-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:mock": "node scripts/sync-assets.mjs",
    "test:mock": "node scripts/mock-mode-acceptance.mjs",
    "test:pwa": "node scripts/test-pwa.mjs",
    "screenshots": "node scripts/capture-screens.mjs",
    "verify:field": "node scripts/field-readiness.mjs"
  },
  "dependencies": {
    "@poseidon/domain": "*",
    "firebase": "^12.19.0",
    "lucide-react": "^1.42.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}

# Loaded by `vite build --mode demo` (npm run build:demo). No secrets belong here.
VITE_POSEIDON_DEMO=true
# Defence in depth: the demo path never imports the Firebase config, but make
# sure a developer's local .env can never be inlined into a demo bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

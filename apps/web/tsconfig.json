{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client",
      "vite-plugin-pwa/client",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "@poseidon/domain": ["../../packages/domain/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
